# List of subs to track on ApeWisdom (comma-separated)
# ApeWisdom covers: wallstreetbets, stocks, investing, options, StockMarket,
# pennystocks, SPACs, wallstreetbetsnew, cryptocurrency, Bitcoin, ethereum
APEWISDOM_SUBS=wallstreetbets,stocks,investing,options,StockMarket,pennystocks,SPACs

# List of subs to fetch post content for from Arctic Shift
# (WSB is intentionally omitted — Arctic Shift has sparse WSB coverage.
# Other subs above are well-archived.)
ARCTIC_SUBS=stocks,investing,options,StockMarket,pennystocks,SPACs

# How many pages (100 tickers each) to pull per sub from ApeWisdom
PAGES_PER_SUB=1
# How many recent posts to pull per sub from Arctic Shift
POSTS_PER_SUB=30
# How many days back to look for posts
POST_LOOKBACK_DAYS=7

# Optional: token required to trigger /api/scrape-now
# If empty, the endpoint is open (set this in production!)
SCRAPE_TOKEN=