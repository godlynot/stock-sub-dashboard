# List of subs to track ticker rankings for on ApeWisdom
SUBS=wallstreetbets,stocks,investing,options,StockMarket,pennystocks,SPACs

# List of subs to fetch post content for from Arctic Shift
# (WSB is intentionally omitted — Arctic Shift has sparse WSB data)
POST_SUBS=stocks,investing,options,StockMarket,pennystocks,SPACs

# How long to cache results in memory (seconds). 3600 = 1 hour.
CACHE_TTL=3600

# How many recent top posts per sub
POSTS_PER_SUB=30

# How many days back to look for posts
POST_LOOKBACK_DAYS=7